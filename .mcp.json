{
  "mcpServers": {
    "google-sheets": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-google-sheets"
      ],
      "env": {
        "GOOGLE_SHEETS_CLIENT_ID": "!/usr/bin/sed -n 's/^GOOGLE_CLIENT_ID=//p' \"$HOME/dev/jobs/.env\"",
        "GOOGLE_SHEETS_CLIENT_SECRET": "!/usr/bin/sed -n 's/^GOOGLE_CLIENT_SECRET=//p' \"$HOME/dev/jobs/.env\"",
        "TOKEN_PATH": "${HOME}/dev/jobs/.mcp/google-sheets-token.json"
      }
    }
  }
}
